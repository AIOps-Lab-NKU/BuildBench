{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildbench.example/schemas/leaderboard-public-v0.1.schema.json",
  "title": "Build-Bench public competition leaderboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metric", "case_set_version", "protocol_version", "entries"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "metric": { "const": "build_success_rate" },
    "case_set_version": { "type": ["string", "null"] },
    "protocol_version": { "type": ["string", "null"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "team_name", "members", "score", "successful_cases",
          "total_cases", "rank"
        ],
        "properties": {
          "team_name": { "type": "string" },
          "members": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "successful_cases": { "type": "integer", "minimum": 0 },
          "total_cases": { "type": "integer", "minimum": 1 },
          "rank": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  }
}
