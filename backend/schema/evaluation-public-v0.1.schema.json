{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildbench.example/schemas/evaluation-public-v0.1.schema.json",
  "title": "Build-Bench participant Full Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "submission_id",
    "status",
    "agent",
    "submission_sha256",
    "snapshot",
    "progress",
    "queued_at",
    "started_at",
    "finished_at",
    "duration_seconds",
    "score",
    "system_message"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "evaluation_id": { "type": "string", "pattern": "^FE-[A-Za-z0-9._-]+$" },
    "submission_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "queued",
        "preparing",
        "evaluating",
        "finalizing",
        "completed",
        "cancelled",
        "system_error"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "submission_sha256": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_set_version",
        "runtime_image_digest",
        "validator_image_digest",
        "protocol_version",
        "feedback_policy"
      ],
      "properties": {
        "case_set_version": { "type": "string", "minLength": 1 },
        "runtime_image_digest": { "type": "string", "minLength": 1 },
        "validator_image_digest": { "type": "string", "minLength": 1 },
        "protocol_version": { "type": "string", "minLength": 1 },
        "feedback_policy": { "type": "string", "minLength": 1 }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "total",
        "percent",
        "running",
        "infrastructure_retries"
      ],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "running": { "type": "integer", "minimum": 0 },
        "infrastructure_retries": { "type": "integer", "minimum": 0 }
      }
    },
    "queued_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "system_message": { "type": ["string", "null"] }
  }
}
